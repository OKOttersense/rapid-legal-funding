'use client';

import { useState, useEffect } from 'react';
import { Header } from '@/components/Header';
import { Footer } from '@/components/Footer';
import { useDashboardStore } from '@/lib/store';
import { MOCK_ATTORNEYS } from '@/lib/utils';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer, PieChart, Pie, Cell } from 'recharts';
import { Filter, Phone, Mail, TrendingUp, Users, DollarSign, CheckCircle } from 'lucide-react';

const MOCK_LEADS = [
  {
    id: '1',
    clientName: 'Robert Johnson',
    caseType: 'personal-injury',
    description: 'Car accident, back injury',
    estimatedValue: 45000,
    qualificationScore: 0.92,
    aiSummary: 'Clear liability, documented injuries. High-value case.',
    keyFacts: ['Hit by truck', '$8K medical bills', 'Lost 2 months work'],
    riskLevel: 'low',
    status: 'pending',
    createdAt: new Date(Date.now() - 2 * 60 * 60 * 1000).toISOString(),
    location: 'Oklahoma City, OK',
    flags: [{ text: 'High value potential', severity: 'info' }],
    attorneyMatchScore: 0.94,
  },
  {
    id: '2',
    clientName: 'Sarah Martinez',
    caseType: 'dui',
    description: 'First-time DUI arrest',
    estimatedValue: 3500,
    qualificationScore: 0.78,
    aiSummary: 'Time-sensitive case. BAC 0.09.',
    keyFacts: ['First offense', 'BAC 0.09', 'No accident'],
    riskLevel: 'medium',
    status: 'pending',
    createdAt: new Date(Date.now() - 4 * 60 * 60 * 1000).toISOString(),
    location: 'Edmond, OK',
    flags: [{ text: 'Time-sensitive', severity: 'warning' }],
    attorneyMatchScore: 0.87,
  },
  {
    id: '3',
    clientName: 'Michael Chen',
    caseType: 'workers-comp',
    description: 'Workplace injury - construction site',
    estimatedValue: 32000,
    qualificationScore: 0.85,
    aiSummary: 'Clear workers comp case. Employer has insurance.',
    keyFacts: ['Construction injury', 'Employer insured', 'Ongoing treatment'],
    riskLevel: 'low',
    status: 'routed',
    createdAt: new Date(Date.now() - 8 * 60 * 60 * 1000).toISOString(),
    location: 'Oklahoma City, OK',
    flags: [],
    attorneyMatchScore: 0.91,
  },
];

const CHART_DATA = [
  { name: 'Mon', leads: 4, closed: 2 },
  { name: 'Tue', leads: 6, closed: 3 },
  { name: 'Wed', leads: 5, closed: 2 },
  { name: 'Thu', leads: 8, closed: 4 },
  { name: 'Fri', leads: 7, closed: 3 },
  { name: 'Sat', leads: 3, closed: 1 },
  { name: 'Sun', leads: 2, closed: 1 },
];

const COLORS = ['#0369a1', '#075985', '#0c3d66', '#082f49'];

export default function DashboardPage() {
  const [attorney, setAttorney] = useState(MOCK_ATTORNEYS[0]);
  const [leads, setLeads] = useState(MOCK_LEADS);
  const [selectedLead, setSelectedLead] = useState<any>(null);
  const [filter, setFilter] = useState('all');
  const { leads: storeLeads, setLeads: setStoreLeads, setSelectedLead: setStoreSelectedLead } = useDashboardStore();

  useEffect(() => {
    setStoreLeads(leads);
  }, [leads, setStoreLeads]);

  const filteredLeads = leads.filter(lead => {
    if (filter === 'all') return true;
    return lead.status === filter;
  });

  const stats = {
    totalLeads: leads.length,
    pendingLeads: leads.filter(l => l.status === 'pending').length,
    closedCases: 12,
    monthlyRevenue: 48500,
  };

  const practiceAreaStats = [
    { name: 'Personal Injury', value: 5, fill: COLORS[0] },
    { name: 'DUI Defense', value: 3, fill: COLORS[1] },
    { name: 'Workers Comp', value: 2, fill: COLORS[2] },
  ];

  return (
    <>
      <Header />
      <main className="min-h-screen bg-gray-50">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
          {/* Attorney Header */}
          <div className="mb-8 bg-white p-6 rounded-lg shadow-md flex justify-between items-center">
            <div>
              <h1 className="text-3xl font-bold">{attorney.name}'s Dashboard</h1>
              <p className="text-gray-600 mt-1">{attorney.firm} • {attorney.yearsExperience}+ years experience</p>
            </div>
            <button className="btn-primary">Settings</button>
          </div>

          {/* Key Metrics */}
          <div className="grid md:grid-cols-4 gap-6 mb-8">
            <div className="metric-card">
              <div className="flex items-center justify-between">
                <div>
                  <div className="metric-label">New Leads This Week</div>
                  <div className="metric-value text-brand-600">{stats.pendingLeads}</div>
                </div>
                <Users className="text-brand-600" size={40} opacity={0.1} />
              </div>
            </div>
            <div className="metric-card">
              <div className="flex items-center justify-between">
                <div>
                  <div className="metric-label">Total Leads</div>
                  <div className="metric-value">{stats.totalLeads}</div>
                </div>
                <Phone className="text-brand-600" size={40} opacity={0.1} />
              </div>
            </div>
            <div className="metric-card">
              <div className="flex items-center justify-between">
                <div>
                  <div className="metric-label">Cases Closed (30d)</div>
                  <div className="metric-value text-green-600">{stats.closedCases}</div>
                </div>
                <CheckCircle className="text-green-600" size={40} opacity={0.1} />
              </div>
            </div>
            <div className="metric-card">
              <div className="flex items-center justify-between">
                <div>
                  <div className="metric-label">Monthly Revenue</div>
                  <div className="metric-value text-green-600">${(stats.monthlyRevenue / 1000).toFixed(0)}K</div>
                </div>
                <DollarSign className="text-green-600" size={40} opacity={0.1} />
              </div>
            </div>
          </div>

          {/* Analytics Row */}
          <div className="grid md:grid-cols-3 gap-6 mb-8">
            {/* Lead Trends */}
            <div className="md:col-span-2 card">
              <h3 className="font-bold text-lg mb-4">Lead & Close Trends (7 Days)</h3>
              <ResponsiveContainer width="100%" height={300}>
                <LineChart data={CHART_DATA}>
                  <CartesianGrid strokeDasharray="3 3" />
                  <XAxis dataKey="name" />
                  <YAxis />
                  <Tooltip />
                  <Legend />
                  <Line type="monotone" dataKey="leads" stroke="#0369a1" strokeWidth={2} />
                  <Line type="monotone" dataKey="closed" stroke="#16a34a" strokeWidth={2} />
                </LineChart>
              </ResponsiveContainer>
            </div>

            {/* Practice Area Breakdown */}
            <div className="card">
              <h3 className="font-bold text-lg mb-4">Practice Areas</h3>
              <ResponsiveContainer width="100%" height={300}>
                <PieChart>
                  <Pie
                    data={practiceAreaStats}
                    cx="50%"
                    cy="50%"
                    labelLine={false}
                    label={({ name, value }) => `${name}: ${value}`}
                    outerRadius={80}
                    fill="#8884d8"
                    dataKey="value"
                  >
                    {practiceAreaStats.map((entry, index) => (
                      <Cell key={`cell-${index}`} fill={entry.fill} />
                    ))}
                  </Pie>
                  <Tooltip />
                </PieChart>
              </ResponsiveContainer>
            </div>
          </div>

          {/* Leads Table */}
          <div className="card">
            <div className="flex justify-between items-center mb-6">
              <h3 className="font-bold text-lg">Recent Leads</h3>
              <div className="flex gap-2">
                <select
                  value={filter}
                  onChange={(e) => setFilter(e.target.value)}
                  className="px-4 py-2 border border-gray-300 rounded-lg text-sm"
                >
                  <option value="all">All Leads</option>
                  <option value="pending">Pending</option>
                  <option value="routed">Routed</option>
                  <option value="contacted">Contacted</option>
                </select>
              </div>
            </div>

            <div className="overflow-x-auto">
              <table className="w-full">
                <thead>
                  <tr className="border-b border-gray-200">
                    <th className="px-4 py-3 text-left text-sm font-semibold text-gray-700">Client Name</th>
                    <th className="px-4 py-3 text-left text-sm font-semibold text-gray-700">Case Type</th>
                    <th className="px-4 py-3 text-left text-sm font-semibold text-gray-700">Est. Value</th>
                    <th className="px-4 py-3 text-left text-sm font-semibold text-gray-700">Match Score</th>
                    <th className="px-4 py-3 text-left text-sm font-semibold text-gray-700">Status</th>
                    <th className="px-4 py-3 text-left text-sm font-semibold text-gray-700">Action</th>
                  </tr>
                </thead>
                <tbody>
                  {filteredLeads.map((lead) => (
                    <tr key={lead.id} className="border-b border-gray-100 hover:bg-gray-50">
                      <td className="px-4 py-3">
                        <button
                          onClick={() => setSelectedLead(lead)}
                          className="font-semibold text-brand-600 hover:underline"
                        >
                          {lead.clientName}
                        </button>
                      </td>
                      <td className="px-4 py-3 text-sm">{lead.caseType.replace('-', ' ')}</td>
                      <td className="px-4 py-3 font-semibold">${(lead.estimatedValue / 1000).toFixed(0)}K</td>
                      <td className="px-4 py-3">
                        <span className={`px-3 py-1 rounded-full text-sm font-semibold ${
                          (lead.attorneyMatchScore || 0) > 0.9
                            ? 'bg-green-100 text-green-700'
                            : 'bg-yellow-100 text-yellow-700'
                        }`}>
                          {((lead.attorneyMatchScore || 0) * 100).toFixed(0)}%
                        </span>
                      </td>
                      <td className="px-4 py-3">
                        <span className={`px-3 py-1 rounded-full text-sm font-medium ${
                          lead.status === 'pending' ? 'bg-blue-100 text-blue-700' :
                          lead.status === 'routed' ? 'bg-purple-100 text-purple-700' :
                          'bg-green-100 text-green-700'
                        }`}>
                          {lead.status.charAt(0).toUpperCase() + lead.status.slice(1)}
                        </span>
                      </td>
                      <td className="px-4 py-3">
                        <button className="text-brand-600 hover:text-brand-700 font-medium text-sm">
                          View
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          {/* Lead Detail Modal */}
          {selectedLead && (
            <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
              <div className="bg-white rounded-lg max-w-2xl w-full max-h-[90vh] overflow-y-auto">
                <div className="sticky top-0 bg-white border-b p-6 flex justify-between items-center">
                  <h2 className="text-2xl font-bold">{selectedLead.clientName}</h2>
                  <button
                    onClick={() => setSelectedLead(null)}
                    className="text-gray-500 hover:text-gray-700 text-2xl"
                  >
                    ✕
                  </button>
                </div>

                <div className="p-6 space-y-6">
                  {/* Summary */}
                  <div className="grid md:grid-cols-2 gap-4">
                    <div>
                      <p className="text-sm text-gray-600">Case Type</p>
                      <p className="font-semibold">{selectedLead.caseType.replace('-', ' ')}</p>
                    </div>
                    <div>
                      <p className="text-sm text-gray-600">Est. Value</p>
                      <p className="font-semibold">${selectedLead.estimatedValue.toLocaleString()}</p>
                    </div>
                    <div>
                      <p className="text-sm text-gray-600">Match Score</p>
                      <p className="font-semibold text-green-600">{((selectedLead.attorneyMatchScore || 0) * 100).toFixed(0)}%</p>
                    </div>
                    <div>
                      <p className="text-sm text-gray-600">Location</p>
                      <p className="font-semibold">{selectedLead.location}</p>
                    </div>
                  </div>

                  {/* Case Description */}
                  <div className="border-t pt-4">
                    <p className="text-sm text-gray-600 mb-2">Case Summary</p>
                    <p>{selectedLead.aiSummary}</p>
                  </div>

                  {/* Key Facts */}
                  <div className="border-t pt-4">
                    <p className="text-sm text-gray-600 mb-3">Key Facts</p>
                    <ul className="space-y-2">
                      {selectedLead.keyFacts.map((fact, i) => (
                        <li key={i} className="flex items-start gap-2">
                          <span className="text-brand-600 font-bold">•</span>
                          <span>{fact}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* Actions */}
                  <div className="border-t pt-4 flex gap-3">
                    <button className="flex-1 btn-primary flex items-center justify-center gap-2">
                      <Phone size={20} /> Call Client
                    </button>
                    <button className="flex-1 btn-secondary flex items-center justify-center gap-2">
                      <Mail size={20} /> Email Client
                    </button>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>
      </main>
      <Footer />
    </>
  );
}
